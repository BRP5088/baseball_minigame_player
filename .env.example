# Copy to .env and fill in. .env is gitignored and must NOT be committed or
# synced to the NAS — each machine keeps its own.
PERSONAL_ANTHROPIC_API_KEY=sk-ant-...

# Optional. Point the 10Hz frame logger at a LOCAL disk when the project itself
# lives on a network mount, so logging cannot distort the loop's press timing.
# BASEBALL_LOG_DIR=/tmp/bb_log
