{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "debugpy",
      "request": "launch",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "name": "Brett: run my walk",
      "program": "${workspaceFolder}/perform_brett_walk.py"
    },
    {
      "type": "debugpy",
      "request": "launch",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "name": "Brett: run my walk (named)",
      "program": "${workspaceFolder}/perform_brett_walk.py",
      "args": [
        "${input:walkName}"
      ]
    },
    {
      "type": "debugpy",
      "request": "launch",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "name": "Brett: check my walk (offline, no console)",
      "program": "${workspaceFolder}/tests/routing/test_brett_walk.py",
      "env": {
        "BASEBALL_TEST_RUN": "1"
      }
    },
    {
      "name": "Where am I? (moves nothing)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Bretts_walk.py",
      "args": [
        "where"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "Doctor: is everything up?",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Bretts_walk.py",
      "args": [
        "doctor"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "Connect: chiaki + stream",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Bretts_walk.py",
      "args": [
        "connect"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "Reset to save point",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Bretts_walk.py",
      "args": [
        "reset"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "Walk: spawn -> table",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Bretts_walk.py",
      "args": [
        "walk",
        "--reset",
        "--shots",
        "/tmp/walk_shots"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "Walk: from here (no reset)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Bretts_walk.py",
      "args": [
        "walk",
        "--shots",
        "/tmp/walk_shots"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "Last mile: Wanda -> table",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Bretts_walk.py",
      "args": [
        "last-mile"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "Last mile: tune durations (prompts)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Bretts_walk.py",
      "args": [
        "last-mile",
        "--durations",
        "${input:cornerSecs}",
        "${input:jukeboxSecs}",
        "${input:tableSecs}"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "Sweep: tune last-mile durations",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Bretts_walk.py",
      "args": [
        "sweep",
        "--out",
        "/tmp/sweep.json"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "Record leg (prompts for both ends + walk)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Bretts_walk.py",
      "args": [
        "record-leg",
        "${input:legFrom}",
        "${input:legTo}",
        "--bearing",
        "${input:legBearing}",
        "--duration",
        "${input:legDuration}"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "Label this spot as a place (prompts)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Bretts_walk.py",
      "args": [
        "label",
        "${input:placeName}"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "Tests (offline, no game)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tests/routing/test_graph_walk.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "env": {
        "BASEBALL_TEST_RUN": "1"
      }
    }
  ],
  "inputs": [
    {
      "id": "legFrom",
      "type": "promptString",
      "description": "leg FROM node",
      "default": "bar_pool_room"
    },
    {
      "id": "legTo",
      "type": "promptString",
      "description": "leg TO node",
      "default": "bar_jukebox"
    },
    {
      "id": "legBearing",
      "type": "promptString",
      "description": "bearing",
      "default": "337.1"
    },
    {
      "id": "legDuration",
      "type": "promptString",
      "description": "seconds",
      "default": "0.8"
    },
    {
      "id": "placeName",
      "type": "promptString",
      "description": "place name",
      "default": "bar_jukebox"
    },
    {
      "id": "cornerSecs",
      "type": "promptString",
      "description": "corner seconds",
      "default": "2.0"
    },
    {
      "id": "jukeboxSecs",
      "type": "promptString",
      "description": "jukebox seconds",
      "default": "3.3"
    },
    {
      "id": "tableSecs",
      "type": "promptString",
      "description": "table seconds",
      "default": "4.1"
    },
    {
      "id": "walkName",
      "type": "promptString",
      "description": "name for this walk's recording",
      "default": "brett"
    }
  ]
}
